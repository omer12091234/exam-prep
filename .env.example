# ── Local demo (default) ──────────────────────────────────────────────
# `npm run demo` starts a local Postgres (no Docker needed) on port 51214,
# applies migrations, seeds the 2023 example exam and runs the site.
# With no Supabase URL set, the site runs in demo mode: no login, one local admin user.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ── Supabase (production) ─────────────────────────────────────────────
# Full guide: docs/DEPLOY.md. Replace the two URLs above and uncomment below.
# Supabase → Connect → Connection String → copy "Transaction pooler" and "Session pooler".
#
# Runtime (also in Vercel): transaction pooler, port 6543.
#   uselibpqcompat=true&sslmode=require = encrypted; without it node-postgres
#   insists on verifying Supabase's non-public certificate and fails.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?uselibpqcompat=true&sslmode=require"
# Migrations only (local, not needed in Vercel): session pooler, port 5432.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres"
#
# Supabase → Project Settings → API Keys
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Only for grading user answers in real time
# ANTHROPIC_API_KEY="sk-ant-..."
